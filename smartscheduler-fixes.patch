+<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>{% block title %}Smart Timetable{% endblock %}</title>
+<script src="https://cdn.tailwindcss.com"></script>
+<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
+<style>
+:root{--bg1:#0f172a;--bg2:#312e81;--card:rgba(255,255,255,.94)}
+body{font-family:Inter,system-ui,sans-serif;background:linear-gradient(135deg,var(--bg1),var(--bg2) 55%,#4c1d95);background-attachment:fixed;min-height:100vh}
+.glass{background:var(--card);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.4);box-shadow:0 10px 40px rgba(0,0,0,.25)}
+.lift{transition:transform .25s,box-shadow .25s}.lift:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(0,0,0,.28)}
+/* Harakatlanuvchi emojilar: kursor yaqinlashganda qochadi, ustiga borganda "pop" qiladi */
+.emo{display:inline-block;cursor:default;user-select:none;transition:transform .35s cubic-bezier(.2,1.6,.4,1);will-change:transform}
+.emo.idle{animation:bob 3.5s ease-in-out infinite}
+@keyframes bob{50%{transform:translateY(-6px) rotate(4deg)}}
+.emo.pop{animation:pop .5s}
+@keyframes pop{40%{transform:scale(1.6) rotate(-14deg)}100%{transform:scale(1)}}
+.now{animation:pulse 1.6s infinite}
+@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.6)}100%{box-shadow:0 0 0 14px rgba(34,197,94,0)}}
+.rise{animation:rise .5s both}@keyframes rise{from{opacity:0;transform:translateY(14px)}}
+@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
+</style>
 </head>
