+        # 4. TASDIQLANGAN TAKLIFLAR: har biri haqiqatan mumkin va jarimani kamaytiradi
+        self.stdout.write(self.style.MIGRATE_HEADING('\n=== 4. TASDIQLANGAN YAXSHILANISHLAR ==='))
+        before_total = s.total_cost()
